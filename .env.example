# Copy this file to .env and fill in the values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# Gmail account that sends the emails
SMTP_USER=yourname@gmail.com
# 16-character Gmail App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_PASS=xxxx xxxx xxxx xxxx

# Where form submissions are delivered (defaults to SMTP_USER)
MAIL_TO=info@assignmentsolution.online
# Display name on outgoing emails
MAIL_FROM_NAME=Assignment Solution
# Send a confirmation email to the student (true/false)
AUTO_REPLY=true

# Only change these if you are not using Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
